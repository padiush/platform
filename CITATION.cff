cff-version: 1.2.0
message: If you use Padiush in your research, please cite it as below.
title: "Padiush"
abstract: >-
  A platform for ethnobotanical and ethnobiological field research. It covers
  instrument design, offline field capture, reconciliation of recorded folk
  names against taxonomic backbones, the standard quantitative indices, and
  export for further analysis.
type: software
version: "1.0.0"
authors:
  - family-names: "Menéndez"
    given-names: "Mercedes"
    orcid: "https://orcid.org/0009-0007-8862-8618"
    country: SV
  - family-names: "Arévalo"
    given-names: "Rodrigo"
    orcid: "https://orcid.org/0009-0008-0614-1417"
    country: SV
doi: 10.5281/zenodo.21943747
identifiers:
  - type: doi
    value: 10.5281/zenodo.21943747
    description: >-
      The concept DOI, which always resolves to the most recent release.
      Cite this when you mean the software rather than one version of it.
  - type: doi
    value: 10.5281/zenodo.21943748
    description: The DOI of version 1.0.0 specifically.
license: AGPL-3.0-or-later
repository-code: "https://github.com/padiush/platform"
url: "https://padiushbio.com"
keywords:
  - ethnobotany
  - ethnobiology
  - field research
  - offline data capture
  - quantitative ethnobotany
  - traditional knowledge

# When the methods paper is published, add a preferred-citation block here so
# that citing the software resolves to the paper.
