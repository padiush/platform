<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="./vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory suffix="Test.php">./tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory suffix="Test.php">./tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory suffix=".php">./app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="CACHE_DRIVER" value="array"/>
        <!--
            DB_* are set as <server> (not just <env>) with force="true":
            container/CI environments inject DB_CONNECTION into $_SERVER, which
            Laravel's env() reads before $_ENV/getenv, so a plain <env> override
            loses and the suite would run against the real database. Forcing the
            $_SERVER entries keeps every test on an isolated in-memory sqlite db.
        -->
        <server name="DB_CONNECTION" value="sqlite" force="true"/>
        <server name="DB_DATABASE" value=":memory:" force="true"/>
        <env name="DB_CONNECTION" value="sqlite" force="true"/>
        <env name="DB_DATABASE" value=":memory:" force="true"/>
        <!--
            Fake AWS credentials (forced like DB_* above): the only S3 use in
            tests is temporaryUrl(), which presigns locally without network.
            This keeps the suite hermetic and CI free of real secrets.
        -->
        <server name="AWS_ACCESS_KEY_ID" value="testing" force="true"/>
        <server name="AWS_SECRET_ACCESS_KEY" value="testing" force="true"/>
        <server name="AWS_DEFAULT_REGION" value="us-east-1" force="true"/>
        <server name="AWS_BUCKET" value="testing" force="true"/>
        <env name="AWS_ACCESS_KEY_ID" value="testing" force="true"/>
        <env name="AWS_SECRET_ACCESS_KEY" value="testing" force="true"/>
        <env name="AWS_DEFAULT_REGION" value="us-east-1" force="true"/>
        <env name="AWS_BUCKET" value="testing" force="true"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
    </php>
</phpunit>
